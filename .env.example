# Example env file for maxtest bot
# Copy to .env or export variables into the service environment.
# Required:
# BOT_TOKEN - Telegram bot token from BotFather
# ADMINS - comma-separated Telegram user IDs who are allowed to use the bot (example: 123456789,987654321)
# Optional:
# PROXY_URL - global fallback proxy (http://host:port or socks5://host:port)

# Example values (replace with real values):
BOT_TOKEN="your_bot_token_here"
ADMINS="8754414647"
#PROXY_URL="http://127.0.0.1:8080"
